<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>460</width>
    <height>720</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string notr="true">EpicJoy MD Rewriter</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout">
    <item>
     <widget class="QGroupBox" name="connectionGroup">
      <property name="title">
       <string>Connection</string>
      </property>
      <layout class="QHBoxLayout" name="connectionLayout">
       <item>
        <widget class="QComboBox" name="portCombo">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Fixed"/>
         </property>
         <property name="toolTip">
          <string>Serial port of the MD Rewriter. It appears when the device is plugged in.</string>
         </property>
         <property name="accessibleName">
          <string>Serial port</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="refreshButton">
         <property name="toolTip">
          <string>Look for serial ports again.</string>
         </property>
         <property name="text">
          <string>&amp;Refresh</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="connectButton">
         <property name="toolTip">
          <string>Open or close the connection to the selected port.</string>
         </property>
         <property name="text">
          <string>&amp;Connect</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="toolsGroup">
      <property name="title">
       <string>Cartridge and tools</string>
      </property>
      <layout class="QHBoxLayout" name="toolsLayout">
       <item>
        <widget class="QPushButton" name="detectButton">
         <property name="toolTip">
          <string>Identify the flash chip of the inserted cartridge.</string>
         </property>
         <property name="text">
          <string>&amp;Detect cartridge</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="compareButton">
         <property name="toolTip">
          <string>Compare two files byte by byte, for example a dump and the original ROM. No device needed.</string>
         </property>
         <property name="text">
          <string>Co&amp;mpare files…</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="romSaveLayout">
      <item>
     <widget class="QGroupBox" name="romGroup">
      <property name="title">
       <string>Game (ROM)</string>
      </property>
      <layout class="QGridLayout" name="romLayout">
       <item row="0" column="0">
        <widget class="QLabel" name="romSizeLabel">
         <property name="text">
          <string>Cartridge &amp;size:</string>
         </property>
         <property name="buddy">
          <cstring>romSizeCombo</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QComboBox" name="romSizeCombo">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Fixed"/>
         </property>
         <property name="toolTip">
          <string>Size of the ROM on the cartridge. Used by Read ROM and by Erase by size. Writing uses the size of the file you choose.</string>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QPushButton" name="readRomButton">
         <property name="toolTip">
          <string>Copy the game from the cartridge to a file on this computer.</string>
         </property>
         <property name="text">
          <string>Read R&amp;OM…</string>
         </property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QPushButton" name="writeRomButton">
         <property name="toolTip">
          <string>Write a ROM file to a rewritable flash cartridge. Erase the cartridge first if it is not blank.</string>
         </property>
         <property name="text">
          <string>&amp;Write ROM…</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
      </item>
      <item>
     <widget class="QGroupBox" name="saveGroup">
      <property name="title">
       <string>Save data (SRAM)</string>
      </property>
      <layout class="QGridLayout" name="saveLayout">
       <item row="0" column="0">
        <widget class="QLabel" name="saveSizeLabel">
         <property name="text">
          <string>Save si&amp;ze:</string>
         </property>
         <property name="buddy">
          <cstring>saveSizeCombo</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QComboBox" name="saveSizeCombo">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Fixed"/>
         </property>
         <property name="toolTip">
          <string>Size of the save memory. Used by Read save. Writing uses the size of the file you choose.</string>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QPushButton" name="readSaveButton">
         <property name="toolTip">
          <string>Copy the saved games from the cartridge to a file on this computer.</string>
         </property>
         <property name="text">
          <string>Read &amp;save…</string>
         </property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QPushButton" name="writeSaveButton">
         <property name="toolTip">
          <string>Replace the saved games on the cartridge with the contents of a file.</string>
         </property>
         <property name="text">
          <string>Write sa&amp;ve…</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QGroupBox" name="eraseGroup">
      <property name="title">
       <string>Erase (destroys data on the cartridge)</string>
      </property>
      <layout class="QGridLayout" name="eraseLayout">
       <item row="0" column="0" colspan="2">
        <widget class="QPushButton" name="eraseSizeButton">
         <property name="toolTip">
          <string>Erase only the flash sectors covered by the cartridge size selected above. Faster than erasing everything.</string>
         </property>
         <property name="text">
          <string>Erase by si&amp;ze…</string>
         </property>
        </widget>
       </item>
       <item row="0" column="2">
        <widget class="QPushButton" name="eraseAllButton">
         <property name="toolTip">
          <string>Erase the whole flash chip and the save memory. This can take several minutes and cannot be interrupted.</string>
         </property>
         <property name="text">
          <string>Erase &amp;all…</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="logGroup">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Preferred" vsizetype="Expanding"/>
      </property>
      <property name="title">
       <string>Log</string>
      </property>
      <layout class="QVBoxLayout" name="logLayout">
       <item>
        <widget class="QPlainTextEdit" name="logView">
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>100</height>
          </size>
         </property>
         <property name="accessibleName">
          <string>Log</string>
         </property>
         <property name="readOnly">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="logButtonsLayout">
         <item>
          <spacer name="logSpacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QPushButton" name="clearLogButton">
           <property name="text">
            <string>C&amp;lear log</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="progressLayout">
      <item>
       <widget class="QProgressBar" name="progressBar">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed"/>
        </property>
        <property name="value">
         <number>0</number>
        </property>
        <property name="accessibleName">
         <string>Progress</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="cancelButton">
        <property name="toolTip">
         <string>Stop the current read, write or comparison.</string>
        </property>
        <property name="text">
         <string>Ca&amp;ncel</string>
        </property>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <tabstops>
  <tabstop>portCombo</tabstop>
  <tabstop>refreshButton</tabstop>
  <tabstop>connectButton</tabstop>
  <tabstop>detectButton</tabstop>
  <tabstop>compareButton</tabstop>
  <tabstop>romSizeCombo</tabstop>
  <tabstop>readRomButton</tabstop>
  <tabstop>writeRomButton</tabstop>
  <tabstop>saveSizeCombo</tabstop>
  <tabstop>readSaveButton</tabstop>
  <tabstop>writeSaveButton</tabstop>
  <tabstop>eraseSizeButton</tabstop>
  <tabstop>eraseAllButton</tabstop>
  <tabstop>logView</tabstop>
  <tabstop>clearLogButton</tabstop>
  <tabstop>cancelButton</tabstop>
 </tabstops>
