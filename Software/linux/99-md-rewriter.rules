# udev rule for the MD Rewriter (STM32 virtual COM port, USB 0483:5740).
# Gives the logged-in user access to the port and stops ModemManager from probing it.
# Install: sudo cp 99-md-rewriter.rules /etc/udev/rules.d/ && sudo udevadm control --reload && replug the device
# Note: 0483:5740 is the generic ST virtual COM port ID, shared by other STM32 devices.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", TAG+="uaccess", MODE="0660", GROUP="dialout", ENV{ID_MM_DEVICE_IGNORE}="1"
